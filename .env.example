# CardPay Suite - environment variables
# Copy this file to ".env" (same folder) on the host and fill in real values.
# .env is gitignored and blocked from web access by the root .htaccess.
# config.php loads it automatically (real OS env vars, if set, take priority).

# GNews API key — powers news.php. Free key: https://gnews.io  (~100 req/day, 12h delay)
GNEWS_API_KEY=your_gnews_key_here

# Groq API key — powers the AI guide (ai-proxy.php). https://console.groq.com
GROQ_API_KEY=your_groq_key_here

# Optional: Google Analytics 4 measurement id (defaults to the one in config.php)
# GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Optional: salt for the proxy rate-limiter's per-visitor hash
# TRACKING_SALT=any_random_string
