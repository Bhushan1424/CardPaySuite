# Block direct HTTP access to the environment file (it holds API keys).
# Works on both Apache 2.4 (mod_authz_core) and 2.2 (mod_access_compat).
<FilesMatch "^\.env">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
